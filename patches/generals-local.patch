@@ -0,0 +1,54 @@
+// GeneralsX @feature Codex 08/10/2026 Fullscreen belongs to the page, not SDL.
+'use strict';
+window.addEventListener('DOMContentLoaded', () => {
+  const button = document.getElementById('gx-fullscreen');
+  const status = document.getElementById('gx-fullscreen-status');
+  const current = () => document.fullscreenElement || document.webkitFullscreenElement;
+  // GeneralsX @bugfix Codex 08/10/2026 Keep launcher controls active during fullscreen transitions.
+  let changing = false;
+  const toggle = async () => {
+    if (changing) return;
+    changing = true;
+    try {
+      status.textContent = '';
+      if (current()) {
+        const exit = document.exitFullscreen || document.webkitExitFullscreen;
+        window.gxPointerLock?.release();
+        await exit.call(document);
+      } else {
+        const root = document.documentElement;
+        const enter = root.requestFullscreen || root.webkitRequestFullscreen;
+        if (!enter) throw new Error('Полный экран недоступен. Откройте игру в обычной вкладке браузера.');
+        // GeneralsX @bugfix Codex 16/10/2026 Give fullscreen its own gesture.
+        // Pointer lock is requested by the next canvas click after entry succeeds.
+        // GeneralsX @bugfix Codex 08/10/2026 Explicitly hide browser navigation.
+        await enter.call(root, {navigationUI: 'hide'});
+      }
+      // The canvas is behind the launcher until the engine starts.
+      if (document.getElementById('gx-overlay').style.display === 'none')
+        document.getElementById('canvas').focus({preventScroll: true});
+    } catch (error) {
+      window.gxPointerLock?.release();
+      console.warn('[fullscreen]', error);
+      status.textContent = 'Браузер не разрешил полный экран. На Mac: Ctrl + ⌘ + F. В Windows: F11.';
+    } finally {
+      changing = false;
+    }
+  };
+  button.addEventListener('click', (event) => {
+    event.stopPropagation();
+    toggle();
+  });
+  // Handle a real keyboard gesture before SDL consumes it; never synthesize one.
+  window.addEventListener('keydown', event => {
+    if (event.altKey && (event.key === 'Enter' || event.code === 'Enter' || event.code === 'NumpadEnter') && !event.repeat) {
+      event.preventDefault(); event.stopImmediatePropagation(); toggle();
+    }
+  }, {capture: true});
+  for (const name of ['fullscreenchange', 'webkitfullscreenchange']) document.addEventListener(name, () => {
+    const active = !!current();
+    button.textContent = active ? '⤡' : '⤢';
+    button.setAttribute('aria-label', active ? 'Выйти из полного экрана' : 'На весь экран');
+    button.title = (active ? 'Выйти из полного экрана' : 'На весь экран') + ' (Alt+Enter)';
+  });
+});
