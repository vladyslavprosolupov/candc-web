+.connection-light { width:5px; height:5px; background:#86b8e2; box-shadow:0 0 8px #5eabff; }
+.readiness:has([data-ready="true"]) { color:#d5ecff; }
+.menu-action { display:block; width:100%; min-height:45px; padding:12px 16px; font:700 16px Arial,sans-serif; color:#dceeff; text-align:center; text-decoration:none; text-shadow:0 2px 2px #000; cursor:pointer; border:1px solid #7998b8; border-radius:0; background:linear-gradient(#224b7c,#0e2a56 48%,#071939 50%,#102a54); box-shadow:inset 0 0 0 1px #092149,0 2px 4px #0008; transition:filter .15s,border-color .15s; }
+.menu-action:hover { filter:brightness(1.3); border-color:#d4eaff; }
+.menu-action:focus-visible, #gx-cancel-import:focus-visible,a:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }
+.menu-action:disabled,.menu-action[aria-disabled="true"] { opacity:.4; cursor:default; filter:none; }
+#gx-package-info { display:block; margin:6px 0 17px; font-size:11px; color:#92abc9; }
+#gx-local-status { margin:13px 0; min-height:32px; font-size:12px; line-height:1.45; color:#b0c1d7; overflow-wrap:anywhere; }
+.play-action { margin-top:16px; border-color:#c2a265; color:#ffe0a3; background:linear-gradient(#665033,#352d26 48%,#1b1c23 50%,#3a3026); text-transform:uppercase; letter-spacing:2px; }
+#gx-detail { margin-top:12px; font-size:11px; line-height:1.4; color:#9aafca; overflow-wrap:anywhere; }
+#gx-error { display:none; margin-top:10px; color:#ffc092; font-size:12px; line-height:1.35; overflow-wrap:anywhere; }
+#gx-progress-wrap { display:none; margin:12px 0; }
+.gx-prog+.gx-prog { margin-top:10px; }
+.gx-prog-head { display:flex; justify-content:space-between; gap:8px; font-size:11px; margin-bottom:5px; color:#bed9f5; }
+.gx-track { height:5px; background:#020d24; border:1px solid #426084; }
+#gx-bar,#gx-bar2 { width:0; height:100%; background:#92c9ff; box-shadow:0 0 8px #54a3ff; transition:width .1s; }
+#gx-cancel-import { border:0; padding:3px; background:none; color:#e0bf87; cursor:pointer; font:12px Arial,sans-serif; }
+.command-footer { position:absolute; bottom:37px; left:42px; right:42px; display:flex; justify-content:space-between; gap:10px; color:#98acc9; font-size:10px; text-shadow:0 1px 3px #000; }
+.command-footer a { color:inherit; text-decoration:none; }
+@media(max-width:700px) { .battlefield { inset:14px; background-position:48% 58%; } .battlefield::after { background:#041334a8; } .menu-frame { border-width:14px; } .menu-frame::before { opacity:.7; } .command-main { justify-content:center; padding:28px 28px 52px; } .deploy-panel { width:350px; padding:18px; } .command-footer { bottom:24px; left:28px; right:28px; font-size:9px; } }
+@media(max-height:650px) { .command-main { padding-top:35px; padding-bottom:51px; } .deploy-panel { padding:14px 18px; } h1 { margin-bottom:10px; } .game-logo { max-height:100px; } .readiness { margin-bottom:12px; } .menu-action { min-height:38px; padding:9px 12px; font-size:14px; } #gx-package-info { margin:4px 0 10px; } #gx-local-status { margin:9px 0; font-size:11px; min-height:28px; } .play-action { margin-top:10px; } #gx-detail { margin-top:8px; } }
+@media(max-height:480px) and (min-width:600px) { .deploy-panel { width:620px; display:grid; grid-template-columns:240px 1fr; column-gap:24px; padding:16px; align-items:center; } h1 { grid-column:1; grid-row:1 / 4; } .game-logo { max-height:120px; } .readiness { grid-column:2; margin-bottom:8px; } #gx-local-data { grid-column:2; } #gx-progress-wrap { grid-column:1; grid-row:4; } .play-action { grid-column:2; margin-top:4px; } #gx-detail,#gx-error { grid-column:1 / -1; } #gx-local-status { margin:6px 0; } .command-main { justify-content:center; } }
+@media(max-height:540px) and (max-width:599px) { .game-logo { max-height:65px; } .deploy-panel { padding:10px 14px; } .readiness { font-size:9px; margin-bottom:8px; } .menu-action { min-height:32px; padding:7px 10px; font-size:13px; } #gx-local-status { margin:6px 0; font-size:10px; } #gx-package-info { margin:3px 0 7px; } .command-main { padding:20px 24px 42px; } }
