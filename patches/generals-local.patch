index 0000000..3147dc9
--- /dev/null
+++ b/web/shell/local-data.js
@@ -0,0 +1,181 @@
+// GeneralsX @feature Codex 08/10/2026 Import owned installations without uploading them.
+'use strict';
+
+function gxPlanLocalFiles(files) {
+  const paths = files.map(file => ({ file, path: file.webkitRelativePath || file.name }));
+  if (paths.some(({path}) => path.split('/').some(p => !p || p === '.' || p === '..') || path.includes('\\')))
+    throw new Error('Invalid installation path.');
+  const roots = suffix => paths.filter(e => e.path.toLowerCase().endsWith('/' + suffix))
+    .map(e => e.path.slice(0, -suffix.length));
+  const zhRoots = roots('inizh.big');
+  const baseRoots = roots('ini.big');
+  if (zhRoots.length !== 1 || baseRoots.length !== 1)
+    throw new Error('Choose the parent folder containing exactly one Generals and one Zero Hour installation (INI.big and INIZH.big).');
+  const output = [];
+  const seen = new Set();
+  for (const {file, path} of paths) {
+    const root = path.startsWith(zhRoots[0]) ? zhRoots[0] : path.startsWith(baseRoots[0]) ? baseRoots[0] : null;
+    if (!root) continue;
+    const rel = path.slice(root.length);
+    if (!(/^[^/]+\.big$/i.test(rel) || /^(Data|Maps)\//i.test(rel))) continue;
+    if (/\.(exe|dll|sys|com|bat|cmd|ps1|sh|lnk)$/i.test(rel)) continue;
+    const dest = (root === baseRoots[0] ? 'GameDataGenerals/' : '') + rel;
+    if (seen.has(dest.toLowerCase())) throw new Error('Duplicate asset: ' + dest);
+    seen.add(dest.toLowerCase());
+    output.push({file, path: dest});
+  }
+  for (const name of ['inizh.big', 'mapszh.big', 'textureszh.big', 'w3dzh.big', 'gamedatagenerals/ini.big'])
+    if (!seen.has(name)) throw new Error('Required game archive missing: ' + name);
+  return output;
+}
+
+async function gxCheckBig(file) {
+  const h = new Uint8Array(await file.slice(0, 16).arrayBuffer());
+  if (h.length !== 16 || !['BIGF', 'BIG4'].includes(String.fromCharCode(...h.slice(0, 4))))
+    throw new Error('Invalid BIG archive: ' + file.name);
+  const v = new DataView(h.buffer);
+  const count = v.getUint32(8), end = v.getUint32(12);
+  if (!count || end < 16 || end > file.size || count > (end - 16) / 9 || end > 16 * 1024 * 1024)
+    throw new Error('Invalid BIG index: ' + file.name);
+  const index = new Uint8Array(await file.slice(0, end).arrayBuffer());
+  const iv = new DataView(index.buffer);
+  let p = 16;
+  for (let i = 0; i < count; i++) {
+    if (p + 9 > end) throw new Error('Truncated BIG index: ' + file.name);
+    const offset = iv.getUint32(p), size = iv.getUint32(p + 4); p += 8;
+    if ((size > 0 && offset < end) || offset + size > file.size) throw new Error('Truncated BIG payload: ' + file.name);
+    const zero = index.indexOf(0, p);
+    if (zero < p || zero >= end) throw new Error('Unterminated BIG entry: ' + file.name);
+    p = zero + 1;
+  }
+}
+
+async function gxInstallLocal(files, storage) {
+  if (storage.kind !== 'opfs') throw new Error('Local import requires OPFS. Use a current desktop Chrome or Edge over HTTPS.');
+  const entries = gxPlanLocalFiles(Array.from(files));
+  const total = entries.reduce((sum, e) => sum + e.file.size, 0);
+  const estimate = await storage.estimate();
+  if (estimate && estimate.quota - estimate.usage < total + 128 * 1024 * 1024)
+    throw new Error('Not enough browser storage. Allow at least ' + gxHuman(total + 128 * 1024 * 1024) + ' free.');
+  for (const entry of entries) if (/\.big$/i.test(entry.path)) await gxCheckBig(entry.file);
+  // Reject a different file set instead of leaving stale archives mixed together.
+  const previous = await storage.readMeta('local-files');
+  const names = entries.map(e => e.path).sort();
+  if (previous && JSON.stringify(previous.paths) !== JSON.stringify(names))
+    throw new Error('A different installation already exists on this site. Use a separate browser profile for another edition.');
+  await storage.writeMeta('installed-local', { complete: false });
+  await storage.writeMeta('local-files', {paths: names});
+  await storage.requestPersist();
+  let done = 0;
+  for (let i = 0; i < entries.length; i++) {
+    const entry = entries[i];
+    gxUI.detail.textContent = 'Установка: ' + entry.path;
+    await storage.writeStream(entry.path, new Response(entry.file.stream()), n => {
+      done += n; gxUI.download(done, total);
+    });
+    gxUI.unpack(i + 1, entries.length);
+  }
+  for (const name of ['arial.ttf', 'arialbold.ttf', 'couriernew.ttf', 'timesnewroman.ttf']) {
+    const response = await fetch('fonts/' + name);
+    if (!response.ok) throw new Error('Bundled font missing: ' + name);
+    await storage.writeStream('fonts/' + name, response);
+  }
+  await storage.writeMeta('installed-local', {complete: true, files: entries.length + 4, ts: Date.now()});
+}
+
+async function gxSetupLocalData(storage, buildSel) {
+  const input = document.getElementById('gx-folder');
+  const archive = document.getElementById('gx-archive');
+  const status = document.getElementById('gx-local-status');
+  const badge = document.getElementById('gx-ready-label');
+  const play = document.getElementById('gx-play');
+  const cancel = document.getElementById('gx-cancel-import');
+  let installed = await storage.readMeta('installed-local'), selectedFiles = null, busy = false;
+  const updateReady = () => {
+    play.disabled = busy || (buildSel.value === 'local' && !selectedFiles && !installed?.complete);
+    badge.textContent = busy ? 'Установка…' : installed?.complete ? 'Готово к запуску' : 'Требуется установка';
+    badge.dataset.ready = installed?.complete && !busy ? 'true' : 'false';
+    document.getElementById('gx-select-archive').disabled = busy;
+    document.getElementById('gx-select-folder').disabled = busy;
+    document.getElementById('gx-settings-btn').disabled = busy;
+    document.getElementById('gx-download').setAttribute('aria-disabled', String(busy || !document.getElementById('gx-download').hasAttribute('href')));
+  };
+  buildSel.addEventListener('change', updateReady);
+  if (installed?.complete) {
+    status.textContent = 'Игра установлена. Файлы и сохранения — на этом устройстве.';
+    gxUI.detail.textContent = 'Можно начинать игру.';
+  }
+  updateReady();
+  try {
+    const response = await fetch('launcher-config.json', {cache:'no-cache'});
+    if (!response.ok) throw new Error('Download configuration unavailable.');
+    const config = await response.json();
+    if (config.downloadUrl) {
+      const url = new URL(config.downloadUrl, location.href);
+      if (url.protocol !== 'https:' && !(url.protocol === 'http:' && ['localhost','127.0.0.1'].includes(url.hostname))) throw new Error('Invalid package download address.');
+      document.getElementById('gx-download').href = url.href;
+      document.getElementById('gx-download').removeAttribute('aria-disabled');
+      document.getElementById('gx-package-info').textContent = config.label || 'Generals + Zero Hour · tar.gz';
+    }
+  } catch (e) { console.warn('[package]', e.message); }
+  document.getElementById('gx-download').addEventListener('click', e => {
+    if (busy || !e.currentTarget.hasAttribute('href')) {e.preventDefault();status.textContent = busy ? 'Дождитесь завершения установки.' : 'Ссылка пока недоступна. Выберите ранее скачанный архив.';}
+  });
+  input.addEventListener('change', () => {
+    if (!input.files.length) return;
+    try {
+      const plan = gxPlanLocalFiles(Array.from(input.files)); selectedFiles = input.files;
+      status.textContent = plan.length + ' файлов · ' + gxHuman(plan.reduce((s,e)=>s+e.file.size,0)) + ' · установка при запуске';
+      buildSel.value = 'local'; localStorage.setItem('gx-build', 'local');
+    } catch(e) {selectedFiles = null;status.textContent = e.message;}
+    updateReady();
+  });
+  document.getElementById('gx-select-folder').addEventListener('click', () => input.click());
+  document.getElementById('gx-select-archive').addEventListener('click', () => archive.click());
+  archive.addEventListener('change', async () => {
+    const file = archive.files[0]; if (!file || busy) return;
+    archive.value = '';
+    if (!/\.(tar\.gz|tgz)$/i.test(file.name)) {status.textContent = 'Выберите скачанный файл .tar.gz.';return;}
+    if (storage.kind !== 'opfs') {status.textContent = 'Откройте игру в Chrome или Edge на компьютере и разрешите хранение файлов.';return;}
+    busy = true; selectedFiles = null; updateReady();
+    document.getElementById('gx-progress-wrap').style.display = 'block';
+    document.getElementById('gx-error').style.display = 'none';
+    document.getElementById('gx-dl-label').textContent = 'Установка…';
+    gxUI.download(0,0); gxUI.unpack(0,0);
+    status.textContent = file.name + ' · чтение файла'; cancel.hidden = false;
+    let worker, cancelImport;
+    try {
+      await storage.requestPersist();
+      await new Promise((resolve,reject) => {
+        worker = new Worker('archive-worker.js');
+        cancelImport = () => { worker.terminate(); reject(new Error('Установка отменена. Выберите этот архив ещё раз.')); };
+        cancel.addEventListener('click', cancelImport);
+        let files = 0;
+        worker.onmessage = ({data:m}) => {
+          if(m.type === 'begin') files=m.files;
+          if(m.type === 'progress') {gxUI.download(m.done,m.total);gxUI.unpack(m.files,files);gxUI.detail.textContent=m.path;}
+          if(m.type === 'done') resolve();
+          if(m.type === 'error') reject(new Error(m.message));
+        };
+        worker.onerror = () => reject(new Error('Ошибка установки. Обновите страницу и выберите архив ещё раз.'));
+        worker.postMessage({file});
+      });
+      buildSel.value = 'local';localStorage.setItem('gx-build','local');
+      status.textContent = 'Игра установлена. Повторное скачивание не требуется.';
+      gxUI.detail.textContent = 'Все файлы проверены. Можно играть.';
+    } catch(e) {console.error('[import]',e);status.textContent=/[А-Яа-яЁё]/.test(e.message) ? e.message : /quota|space|storage/i.test(e.message) ? 'Недостаточно места. Освободите не менее 3 ГБ в хранилище браузера.' : 'Не удалось прочитать архив. Скачайте файл заново и повторите установку.';gxUI.detail.textContent='Выберите архив ещё раз. Сохранения не затронуты.';}
+    finally {
+      worker?.terminate(); if(cancelImport) cancel.removeEventListener('click',cancelImport);
+      cancel.hidden=true; busy=false; installed=await storage.readMeta('installed-local'); updateReady();
+      document.getElementById('gx-progress-wrap').style.display='none';
+    }
+  });
+  return async () => {
+    if (buildSel.value !== 'local') return;
+    document.getElementById('gx-local-data').hidden = true;
+    if (selectedFiles) await gxInstallLocal(selectedFiles, storage);
+    else if (!(await storage.readMeta('installed-local'))?.complete) throw new Error('Сначала установите игру из архива. Обновите страницу и повторите.');
+  };
+}
+
+if (typeof module !== 'undefined') module.exports = { gxPlanLocalFiles, gxCheckBig };
diff --git a/web/shell/pointer-lock.js b/web/shell/pointer-lock.js
new file mode 100644
index 0000000..1ed77f1
--- /dev/null
+++ b/web/shell/pointer-lock.js
@@ -0,0 +1,126 @@
+// GeneralsX @feature Codex 15/10/2026 Confine the game cursor with browser Pointer Lock.
+'use strict';
+window.addEventListener('DOMContentLoaded', () => {
+  const canvas = document.getElementById('canvas');
+  const overlay = document.getElementById('gx-overlay');
+  const status = document.getElementById('gx-fullscreen-status');
+  const button = document.getElementById('gx-fullscreen');
+  const cursor = document.createElement('img');
+  cursor.id = 'gx-game-cursor';
+  cursor.alt = '';
+  cursor.draggable = false;
+  cursor.hidden = true;
+  cursor.setAttribute('aria-hidden', 'true');
+  document.body.appendChild(cursor);
+  const fullscreen = () => document.fullscreenElement || document.webkitFullscreenElement;
+  const locked = () => document.pointerLockElement === canvas;
+  const playing = () => overlay.style.display === 'none' && position !== null;
+  let position = null;
+  let hotspot = [0, 0];
+  let pending = false;
+  let swallowUp = false;
+  let lastStyle = '';
+
+  function draw() {
+    cursor.hidden = !locked() || !position || !cursor.getAttribute('src');
+    if (cursor.hidden) return;
+    const rect = canvas.getBoundingClientRect();
+    cursor.style.transform = `translate(${rect.left + position.x / position.width * rect.width - hotspot[0]}px, ${rect.top + position.y / position.height * rect.height - hotspot[1]}px)`;
+  }
+
+  function updateCursor() {
+    // SDL renders the original ANI frames as CSS data URLs. Reuse each frame
+    // and its hotspot instead of substituting a generic cursor during lock.
+    const style = canvas.style.cursor;
+    if (style === lastStyle) return;
+    lastStyle = style;
+    const match = /^url\(["']?(data:image\/[^"')]+)["']?\)(?:\s+(-?\d+)\s+(-?\d+))?/.exec(style);
+    if (match) {
+      cursor.src = match[1];
+      hotspot = [Number(match[2] || 0), Number(match[3] || 0)];
+    } else if (style === 'none') {
+      cursor.removeAttribute('src');
+    }
+    draw();
+  }
+  new MutationObserver(updateCursor).observe(canvas, {attributes: true, attributeFilter: ['style']});
+
+  function release() {
+    if (locked()) document.exitPointerLock();
+  }
+
+  async function request() {
+    if (!playing() || !fullscreen() || locked() || pending) return;
+    if (!canvas.requestPointerLock) {
+      status.textContent = 'Захват мыши недоступен в этом браузере.';
+      return;
+    }
+    pending = true;
+    try {
+      // A fresh canvas gesture follows successful fullscreen entry.
+      await canvas.requestPointerLock();
+    } catch (error) {
+      console.warn('[pointer-lock]', error);
+      status.textContent = 'Разрешите захват мыши и щёлкните по игре ещё раз.';
+    } finally {
+      pending = false;
+    }
+  }
+
+  window.gxPointerLock = {
+    request, release,
+    // Called on the browser main thread by SDL3Mouse. SDL's accumulated,
+    // clamped position is the single source of truth for drawing and clicks.
+    frame(x, y, width, height) {
+      if (width > 0 && height > 0) position = {x, y, width, height};
+      updateCursor();
+      draw();
+      return locked();
+    },
+  };
+
+  document.addEventListener('pointerlockchange', () => {
+    pending = false;
+    // An asynchronous grant can arrive after the user has left fullscreen.
+    if (locked() && !fullscreen()) {
+      release();
+      return;
+    }
+    button.style.visibility = locked() ? 'hidden' : '';
+    status.textContent = locked() ? '' : (fullscreen() && playing() ? 'Щёлкните по игре, чтобы захватить мышь.' : '');
+    updateCursor();
+    draw();
+  });
+  document.addEventListener('pointerlockerror', () => {
+    pending = false;
+    status.textContent = 'Разрешите захват мыши и щёлкните по игре ещё раз.';
+  });
+  for (const name of ['fullscreenchange', 'webkitfullscreenchange']) {
+    document.addEventListener(name, () => {
+      if (!fullscreen()) {
+        release();
+        status.textContent = '';
+      } else if (playing() && !locked()) {
+        status.textContent = 'Щёлкните по игре, чтобы захватить мышь.';
+      }
+      draw();
+    });
+  }
+  window.addEventListener('blur', release);
+  document.addEventListener('visibilitychange', () => { if (document.hidden) release(); });
+  window.addEventListener('resize', draw);
+  window.addEventListener('pointerdown', event => {
+    if (event.target !== canvas || !fullscreen() || !playing() || locked()) return;
+    // The activation click must not also order a unit or press a game button.
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    swallowUp = true;
+    if (event.button === 0) request();
+  }, {capture: true});
+  window.addEventListener('pointerup', event => {
+    if (!swallowUp) return;
+    swallowUp = false;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+  }, {capture: true});
+});
diff --git a/web/shell/save-backup.js b/web/shell/save-backup.js
new file mode 100644
index 0000000..4e25aa4
--- /dev/null
+++ b/web/shell/save-backup.js
@@ -0,0 +1,73 @@
+// GeneralsX @feature Codex 08/10/2026 Portable saves between browser origins.
+'use strict';
+function gxValidateBackup(value) {
+  if (value?.format !== 'generals-web-userdata-v1' || !Array.isArray(value.files) || value.files.length > 5000)
+    throw new Error('Это не резервная копия сохранений Generals.');
+  const seen = new Set();
+  let bytes = 0;
+  for (const entry of value.files) {
+    if (typeof entry.path !== 'string' || !entry.path || entry.path.length > 1024 || entry.path.includes('\\') ||
+        /[\x00-\x1f]/.test(entry.path) || entry.path.split('/').some(p => !p || p === '.' || p === '..') ||
+        typeof entry.data !== 'string' || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(entry.data) || seen.has(entry.path))
+      throw new Error('Некорректный файл в резервной копии.');
+    seen.add(entry.path); bytes += entry.data.length;
+    if (bytes > 180 * 1024 * 1024) throw new Error('Резервная копия слишком большая.');
+  }
+  return value.files;
+}
+async function gxSetupSaveBackup(storage) {
+  const status = document.getElementById('gx-backup-status');
+  const exportButton = document.getElementById('gx-export-saves');
+  const restoreButton = document.getElementById('gx-import-saves');
+  if (storage.kind !== 'opfs') { exportButton.disabled = restoreButton.disabled = true; return; }
+  const saveFile = async (dir, path, blob) => {
+    const parts = path.split('/'); const name = parts.pop();
+    for (const part of parts) dir = await dir.getDirectoryHandle(part, {create: true});
+    const handle = await dir.getFileHandle(name, {create: true});
+    const writer = await handle.createWritable();
+    await writer.write(blob); await writer.close();
+  };
+  exportButton.addEventListener('click', async () => {
+    try {
+      const files = [];
+      let size = 0;
+      const walk = async (dir, prefix) => {
+        for await (const [name, handle] of dir) {
+          const path = prefix + name;
+          if (handle.kind === 'directory') await walk(handle, path + '/');
+          else {
+            const file = await handle.getFile(); size += file.size;
+            if (size > 128 * 1024 * 1024) throw new Error('Размер превышает 128 МБ. Удалите ненужные повторы.');
+            const bytes = new Uint8Array(await file.arrayBuffer());
+            let text = '';
+            for (let i = 0; i < bytes.length; i += 32768) text += String.fromCharCode(...bytes.subarray(i, i + 32768));
+            files.push({path, data: btoa(text)});
+          }
+        }
+      };
+      try { await walk(await storage.root.getDirectoryHandle('userdata'), ''); }
+      catch (e) { if (e.name !== 'NotFoundError') throw e; }
+      if (!files.length) throw new Error('На этом сайте ещё нет сохранений.');
+      const blob = new Blob([JSON.stringify({format: 'generals-web-userdata-v1', files})], {type: 'application/json'});
+      const url = URL.createObjectURL(blob); const a = document.createElement('a');
+      a.href = url; a.download = 'generals-saves-' + new Date().toISOString().slice(0,10) + '.json'; a.click();
+      setTimeout(() => URL.revokeObjectURL(url), 60000);
+      status.textContent = 'Скачано файлов: ' + files.length + '. Сохраните копию перед сменой сайта или браузера.';
+    } catch (e) { console.error('[saves]', e); status.textContent = /[А-Яа-яЁё]/.test(e.message) ? e.message : 'Не удалось прочитать сохранения. Закройте вкладки с запущенной игрой и повторите.'; }
+  });
+  const input = document.getElementById('gx-save-file');
+  restoreButton.addEventListener('click', () => input.click());
+  input.addEventListener('change', async () => {
+    try {
+      const file = input.files[0]; if (!file) return;
+      if (file.size > 180 * 1024 * 1024) throw new Error('Размер резервной копии превышает 180 МБ.');
+      const files = gxValidateBackup(JSON.parse(await file.text()));
+      if (!confirm('Восстановить файлов: ' + files.length + '? Совпадающие сохранения и настройки будут заменены. Сначала скачайте резервную копию.')) return;
+      const dir = await storage.root.getDirectoryHandle('userdata', {create: true});
+      for (const entry of files) await saveFile(dir, entry.path, new Blob([Uint8Array.from(atob(entry.data), c => c.charCodeAt(0))]));
+      status.textContent = 'Восстановлено файлов: ' + files.length + '. Можно запускать игру.';
+    } catch (e) { console.error('[saves]', e); status.textContent = /[А-Яа-яЁё]/.test(e.message) ? e.message : 'Не удалось прочитать сохранения. Закройте вкладки с запущенной игрой и повторите.'; }
+    finally { input.value = ''; }
+  });
+}
+if (typeof module !== 'undefined') module.exports = {gxValidateBackup};
