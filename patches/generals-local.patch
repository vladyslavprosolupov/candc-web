diff --git a/Core/GameEngineDevice/Source/OpenALAudioDevice/OpenALBufferLease.h b/Core/GameEngineDevice/Source/OpenALAudioDevice/OpenALBufferLease.h
new file mode 100644
index 0000000..3b56c62
--- /dev/null
+++ b/Core/GameEngineDevice/Source/OpenALAudioDevice/OpenALBufferLease.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <AL/al.h>
+
+// GeneralsX @bugfix Codex 16/10/2026 Detach the device reference before releasing cache ownership.
+// Stopped OpenAL sources still retain AL_BUFFER. Loading the next portion can
+// evict the old cache entry, so it must already be detached at that boundary.
+template <class CloseBuffer>
+inline void releaseOpenALBufferLease(ALuint source, ALuint& buffer, CloseBuffer closeBuffer)
+{
+    if (source) {
+        alSourceStop(source);
+        alSourcei(source, AL_BUFFER, 0);
+    }
+    if (buffer) closeBuffer(buffer);
+    buffer = 0;
+}
