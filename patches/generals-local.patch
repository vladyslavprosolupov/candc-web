+/* GeneralsX @feature Codex 08/10/2026 Retail blue grid, steel trim and a viewport-bound Russian menu. */
+:root { color-scheme: dark; --ice:#bce7ff; --line:#638caf; --blue:#071c54; --gold:#f4bd65; }
+* { box-sizing:border-box; }
+[hidden] { display:none !important; }
+#gx-overlay { position:fixed; inset:0; z-index:25; height:100dvh; overflow:hidden; background:#051541; color:#edf5ff; font-family:Arial,"Segoe UI",sans-serif; isolation:isolate; }
