new file mode 100644
index 0000000..12159fb
--- /dev/null
+++ b/web/shell/archive-core.js
@@ -0,0 +1,65 @@
+// GeneralsX @feature Codex 08/10/2026 Bounded, validated TAR stream extraction.
+'use strict';
+function gxAssetPath(path) {
+  if (typeof path !== 'string' || path.length > 255 || /[\\\x00-\x1f:]/.test(path) || path.split('/').some(p => !p || p === '.' || p === '..')) throw new Error('Unsafe archive path.');
+  const rel = path.replace(/^GameDataGenerals\//, '');
+  if (!(/^[^/]+\.big$/i.test(rel) || /^(Data|Maps)\//i.test(rel)) || /\.(exe|dll|sys|com|bat|cmd|ps1|sh|lnk)$/i.test(rel)) throw new Error('Unsupported game asset: ' + path);
+  return path;
+}
+function gxArchiveManifest(value) {
+  if (value?.format !== 'generals-web-tar-v1' || !Array.isArray(value.files) || !value.files.length || value.files.length > 100000) throw new Error('Not a Generals Web game package.');
+  const seen = new Set(); let total = 0;
+  for (const f of value.files) {
+    gxAssetPath(f.path);
+    if (!Number.isSafeInteger(f.size) || f.size < 0 || f.size > 4 * 1024 ** 3 || seen.has(f.path.toLowerCase())) throw new Error('Invalid or duplicate asset: ' + f.path);
+    seen.add(f.path.toLowerCase()); total += f.size;
+  }
+  if (total > 16 * 1024 ** 3) throw new Error('Game package exceeds 16 GiB.');
+  for (const path of ['inizh.big','mapszh.big','textureszh.big','w3dzh.big','gamedatagenerals/ini.big']) if (!seen.has(path)) throw new Error('Required game archive missing: ' + path);
+  return {files:value.files, total};
+}
+function gxTarHeader(h) {
+  const dec = new TextDecoder('utf-8', {fatal:true});
+  const str = (a,n) => dec.decode(h.subarray(a,a+n)).split('\0')[0];
+  const oct = (a,n) => {const s=str(a,n).trim(); if (!/^[0-7]+$/.test(s)) throw new Error('Invalid TAR number.'); return parseInt(s,8);};
+  if (h.every(b=>b===0)) return null;
+  const sum = h.reduce((s,b,i)=>s+(i>=148&&i<156?32:b),0);
+  if (sum !== oct(148,8)) throw new Error('Damaged TAR header.');
+  if (![0,48].includes(h[156]) || str(257,5)!=='ustar') throw new Error('Only regular USTAR files are supported.');
+  const prefix=str(345,155), name=str(0,100);
+  return {path:prefix?prefix+'/'+name:name, size:oct(124,12)};
+}
+async function gxExtractTar(stream, hooks) {
+  const reader=stream.getReader(); let chunk=new Uint8Array(), offset=0;
+  async function take(n, write) {
+    while(n) {
+      if(offset===chunk.length) {const item=await reader.read(); if(item.done) throw new Error('Truncated game archive.'); chunk=item.value;offset=0;}
+      const part=chunk.subarray(offset,offset+Math.min(n,chunk.length-offset));
+      await write(part); offset+=part.length;n-=part.length;
+    }
+  }
+  async function bytes(n) {const out=new Uint8Array(n);let p=0;await take(n,b=>{out.set(b,p);p+=b.length;});return out;}
+  const padding = n => take((512-n%512)%512, b=>{if(b.some(x=>x!==0)) throw new Error('Invalid TAR padding.');});
+  try {
+    const first=gxTarHeader(await bytes(512));
+    if(first?.path!=='generals-manifest.json' || first.size>2*1024*1024) throw new Error('Choose the prepared Generals Web tar.gz package.');
+    const manifest=gxArchiveManifest(JSON.parse(new TextDecoder().decode(await bytes(first.size))));
+    await padding(first.size); await hooks.begin(manifest);
+    let done=0;
+    for (const expected of manifest.files) {
+      const entry=gxTarHeader(await bytes(512));
+      if(!entry || entry.path!==expected.path || entry.size!==expected.size) throw new Error('Archive does not match its manifest: ' + expected.path);
+      const writer=await hooks.open(entry);
+      try {await take(entry.size,async b=>{await writer.write(b);done+=b.length;hooks.progress?.(done,manifest.total,entry.path);}); await writer.close();}
+      catch(e) {await writer.abort();throw e;}
+      await padding(entry.size);
+    }
+    // Drain gzip fully: DecompressionStream verifies its CRC/trailer at EOF.
+    const end=await bytes(1024); if(end.some(b=>b!==0)) throw new Error('Unexpected files after manifest.');
+    if(chunk.subarray(offset).some(b=>b!==0)) throw new Error('Trailing archive data.');
+    let trailing=chunk.length-offset;
+    for (;;) {const next=await reader.read();if(next.done)break;trailing+=next.value.length;if(trailing>1024*1024||next.value.some(b=>b!==0))throw new Error('Trailing archive data.');}
+    await hooks.finish(manifest); return manifest;
+  } finally {await reader.cancel().catch(()=>{});reader.releaseLock();}
+}
+if(typeof module!=='undefined') module.exports={gxAssetPath,gxArchiveManifest,gxTarHeader,gxExtractTar};
diff --git a/web/shell/archive-worker.js b/web/shell/archive-worker.js
new file mode 100644
index 0000000..baa9946
--- /dev/null
+++ b/web/shell/archive-worker.js
@@ -0,0 +1,41 @@
+// GeneralsX @feature Codex 08/10/2026 Stream a selected gzip file into OPFS off the UI thread.
+'use strict';
+importScripts('archive-core.js', 'local-data.js');
+self.onmessage = async ({data:{file}}) => {
+  try {
+    if(!self.DecompressionStream) throw new Error('This browser cannot extract gzip. Use current desktop Chrome or Edge.');
+    const root=await navigator.storage.getDirectory();
+    async function handle(path) {const parts=path.split('/');let dir=root;for(const p of parts.slice(0,-1))dir=await dir.getDirectoryHandle(p,{create:true});return dir.getFileHandle(parts.at(-1),{create:true});}
+    async function readMeta(key) {try{return JSON.parse(await (await (await root.getDirectoryHandle('meta')).getFileHandle(key+'.json')).getFile().then(f=>f.text()));}catch{return null;}}
+    async function meta(key,value) {const h=await handle('meta/'+key+'.json');const w=await h.createWritable();await w.write(JSON.stringify(value));await w.close();}
+    let count=0,last=0;
+    await gxExtractTar(file.stream().pipeThrough(new DecompressionStream('gzip')), {
+      async begin(m) {
+        const estimate=await navigator.storage.estimate();
+        if(estimate.quota-estimate.usage<m.total+128*1024**2)throw new Error('Not enough browser storage. Free at least '+(m.total/1024**3+.13).toFixed(2)+' GiB, then retry.');
+        const names=m.files.map(f=>f.path).sort(), old=await readMeta('local-files');
+        if(old && JSON.stringify(old.paths)!==JSON.stringify(names))throw new Error('A different installation exists. Use a separate browser profile for this edition.');
+        await meta('installed-local',{complete:false});await meta('local-files',{paths:names});
+        postMessage({type:'begin',total:m.total,files:m.files.length});
+      },
+      async open(entry) {
+        const path=entry.path.startsWith('GameDataGenerals/')?entry.path:'GameData/'+entry.path;
+        const fh=await handle(path), w=await fh.createSyncAccessHandle();let pos=0,closed=false;
+        return {
+          write(b) {let offset=0;while(offset<b.length){const n=w.write(b.subarray(offset),{at:pos});if(!n)throw new Error('Storage write failed.');pos+=n;offset+=n;}},
+          async close() {w.truncate(pos);w.flush();w.close();closed=true;if(/\.big$/i.test(entry.path))await gxCheckBig(await fh.getFile());count++;},
+          abort() {if(!closed)w.close();}
+        };
+      },
+      progress(done,total,path) {if(performance.now()-last>120){last=performance.now();postMessage({type:'progress',done,total,path,files:count});}},
+      async finish(m) {
+        for(const name of ['arial.ttf','arialbold.ttf','couriernew.ttf','timesnewroman.ttf']) {
+          const response=await fetch('fonts/'+name);if(!response.ok)throw new Error('Bundled font unavailable. Retry when connected.');
+          const fh=await handle('GameData/fonts/'+name), w=await fh.createWritable();await response.body.pipeTo(w);
+        }
+        await meta('installed-local',{complete:true,files:m.files.length+4,ts:Date.now()});
+      }
+    });
+    postMessage({type:'done'});
+  } catch(e) {postMessage({type:'error',message:e.message});}
+};
