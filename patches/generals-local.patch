 void SDL3Mouse::update(void)
 {
+#ifdef __EMSCRIPTEN__
+	// GeneralsX @feature Codex 15/10/2026 Draw the locked cursor at SDL's real hit-test position.
+	// The browser SDL backend accumulates relative Pointer Lock motion and clamps
+	// it to the window even without SDL's FPS-style relative mouse mode.
+	float x = 0, y = 0;
+	SDL_MouseButtonFlags buttons = SDL_GetMouseState(&x, &y);
+	int width = 0, height = 0;
+	SDL_GetWindowSize(m_Window, &width, &height);
+	bool locked = MAIN_THREAD_EM_ASM_INT({
+		return window.gxPointerLock ? window.gxPointerLock.frame($0, $1, $2, $3) : 0;
+	}, x, y, width, height);
+	if (m_webPointerLocked && !locked && width > 0 && height > 0)
+	{
+		// Esc/blur can release Pointer Lock without sending button-up or motion.
+		// End drags and move off the edge so the camera cannot keep scrolling.
+		for (int button = SDL_BUTTON_LEFT; button <= SDL_BUTTON_RIGHT; ++button)
+		{
+			if (buttons & SDL_BUTTON_MASK(button))
+			{
+				SDL_Event event = {};
+				event.type = SDL_EVENT_MOUSE_BUTTON_UP;
+				event.button.windowID = SDL_GetWindowID(m_Window);
+				event.button.button = button;
+				event.button.x = x;
+				event.button.y = y;
+				addSDLEvent(&event);
+			}
+		}
+		SDL_WarpMouseInWindow(m_Window, width / 2.0f, height / 2.0f);
+		SDL_Event event = {};
+		event.type = SDL_EVENT_MOUSE_MOTION;
+		event.motion.windowID = SDL_GetWindowID(m_Window);
+		event.motion.x = width / 2.0f;
+		event.motion.y = height / 2.0f;
+		addSDLEvent(&event);
+	}
+	m_webPointerLocked = locked;
+#endif
 	// Call parent update (processes events, updates m_currMouse)
 	Mouse::update();
 }
