index 0000000..38cb1b9
--- /dev/null
+++ b/scripts/web/apply-sdl-diagnostics.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Apply the maintained temporary SDL 3.4.2 patch, fail closed on source drift."""
+from pathlib import Path
+import hashlib
+import subprocess
+import sys
+
+PRISTINE = '072576aed2027797079a92dfe1d2610f67afeb70dab90262866158576a7630b8'
+PATCHED = 'eca9e914c6851641581e75228e83cfe78b382023c6f8f8c962ac0270118ae782'
+
+def apply(source, patch):
+    target = source / 'src/events/SDL_events.c'
+    digest = hashlib.sha256(target.read_bytes()).hexdigest()
+    if digest == PATCHED:
+        return
+    if digest != PRISTINE:
+        raise SystemExit('SDL diagnostics patch requires the pinned pristine SDL 3.4.2 source')
+    subprocess.run(['patch', '--batch', '-p1', '-i', str(patch.resolve())], cwd=source, check=True)
+    if hashlib.sha256(target.read_bytes()).hexdigest() != PATCHED:
+        raise SystemExit('SDL diagnostics patch verification failed')
+
+if __name__ == '__main__':
+    apply(Path(sys.argv[1]), Path(sys.argv[2]))
