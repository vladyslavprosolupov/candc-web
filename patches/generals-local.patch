@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Keep SDL window creation from exiting page-owned fullscreen; reject source drift."""
+from pathlib import Path
+import hashlib
+import subprocess
+import sys
+
+PRISTINE = 'bbef5b57371103088358e783106e6ffd493cd40141e21836c9c1c447144e2dbe'
+PATCHED = 'b87ece219c268f255393571c3cec5f24aba3444b19f6dfb2e4beeed7f12fce85'
+
+def apply(source):
+    target = source / 'src/video/emscripten/SDL_emscriptenvideo.c'
+    original = target.read_bytes()
+    digest = hashlib.sha256(original).hexdigest()
+    if digest == PATCHED:
+        return
+    if digest != PRISTINE:
+        raise SystemExit('SDL fullscreen patch requires the pinned pristine SDL 3.4.2 source')
+    patch = Path(__file__).resolve().parents[2] / 'Patches/sdl3-page-fullscreen.patch'
+    subprocess.run(['patch', '--batch', '-p1', '-i', str(patch)], cwd=source, check=True)
+    if hashlib.sha256(target.read_bytes()).hexdigest() != PATCHED:
+        raise SystemExit('SDL fullscreen patch verification failed')
+
+if __name__ == '__main__':
+    apply(Path(sys.argv[1]))
