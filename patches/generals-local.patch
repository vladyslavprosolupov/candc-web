+.battlefield::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,rgba(4,16,43,.12) 10%,rgba(4,16,43,.28) 40%,rgba(3,15,44,.94) 72%),linear-gradient(0deg,#041334 0%,transparent 35%); }
+.menu-frame { position:absolute; inset:0; z-index:-2; border:26px solid #071948; box-shadow:inset 0 0 0 1px #a9bed5,inset 0 0 0 3px #1c4876,inset 0 0 40px #071329; pointer-events:none; }
+.menu-frame::before { content:""; position:fixed; inset:0; border:1px solid #456588; background:repeating-linear-gradient(0deg,transparent 0 11px,#739ac124 11px 12px),repeating-linear-gradient(90deg,transparent 0 11px,#739ac124 11px 12px); mask:linear-gradient(#000,#000) top/100% 25px no-repeat,linear-gradient(#000,#000) bottom/100% 25px no-repeat,linear-gradient(#000,#000) left/25px 100% no-repeat,linear-gradient(#000,#000) right/25px 100% no-repeat; }
+.command-main { height:100%; padding:44px max(6vw,40px) 64px; display:flex; justify-content:flex-end; align-items:center; min-height:0; }
+.deploy-panel { width:min(390px,100%); text-align:center; padding:22px 20px; background:linear-gradient(180deg,#091b42b0,#071538ed); border:1px solid #55779b; box-shadow:0 0 0 2px #061329,0 0 0 3px #8ca0b34d,0 12px 50px #0009,inset 0 0 35px #102e6399; }
+h1 { margin:0 0 18px; line-height:0; }
+.game-logo { width:100%; height:auto; max-height:clamp(72px,21vh,149px); object-fit:contain; filter:drop-shadow(0 5px 8px #000); }
