diff --git a/Core/GameEngineDevice/Include/WebInputDiagnostics.h b/Core/GameEngineDevice/Include/WebInputDiagnostics.h
new file mode 100644
index 0000000..e9f9b72
--- /dev/null
+++ b/Core/GameEngineDevice/Include/WebInputDiagnostics.h
@@ -0,0 +1,165 @@
+#pragma once
+// GeneralsX @feature Codex 16/10/2026 Read-only browser input pipeline telemetry.
+#if defined(__EMSCRIPTEN__) && defined(GX_WEB_INPUT_DIAGNOSTICS)
+#include <SDL3/SDL.h>
+#include <emscripten.h>
+#include <emscripten/proxying.h>
+#include <emscripten/threading.h>
+// Emscripten 4.0.10 dlmalloc ABI (SDK compat/malloc.h), size_t fields.
+// Including compat/malloc.h directly breaks its include_next search path.
+struct mallinfo {
+    size_t arena, ordblks, smblks, hblks, hblkhd, usmblks, fsmblks, uordblks, fordblks, keepcost;
+};
+extern "C" struct mallinfo mallinfo(void);
+#include "GameClient/GameClient.h"
+#include "GameClient/GameWindow.h"
+#include "GameClient/GameWindowManager.h"
+#include "GameClient/InGameUI.h"
+#include "GameClient/Mouse.h"
+#include "GameLogic/GameLogic.h"
+#include "Common/GlobalData.h"
+
+extern "C" void SDL_GXSetInputDiagnosticsEnabled(bool enabled);
+extern "C" void SDL_GXGetInputDiagnostics(Uint32* values);
+
+struct GxWebInputCounters {
+    bool enabled = false, checked = false;
+    unsigned pollCalls = 0, missingWindow = 0, sequence = 0;
+    unsigned polled = 0, mouseIn = 0, mouseOut = 0, mouseDropped = 0;
+    unsigned buttonIn = 0, buttonOut = 0, buttonDropped = 0;
+    unsigned keyIn = 0, keyOut = 0, keyDropped = 0, updates = 0;
+    Uint64 sampledAt = 0;
+};
+inline GxWebInputCounters& gxWebInputCounters() {
+    // All accesses happen on the engine thread; the browser receives copies.
+    static GxWebInputCounters counters;
+    return counters;
+}
+inline void gxWebMouseEvent(const SDL_Event& event, int stage) {
+    GxWebInputCounters& c = gxWebInputCounters();
+    if (!c.enabled) return;
+    bool button = event.type == SDL_EVENT_MOUSE_BUTTON_DOWN || event.type == SDL_EVENT_MOUSE_BUTTON_UP;
+    if (stage == 0) { ++c.mouseIn; if (button) ++c.buttonIn; }
+    if (stage == 1) { ++c.mouseOut; if (button) ++c.buttonOut; }
+    if (stage == 2) { ++c.mouseDropped; if (button) ++c.buttonDropped; }
+}
+inline int gxWebWindowId(GameWindow* window) { return window ? window->winGetWindowId() : 0; }
+// Read the main runtime thread's own SDL error buffer, without clearing it.
+inline void gxWebMainSdlError(void* output) {
+    SDL_strlcpy(static_cast<char*>(output), SDL_GetError(), 256);
+}
+inline void gxWebInputSample(bool active) {
+    GxWebInputCounters& c = gxWebInputCounters();
+    if (!c.checked) {
+        c.enabled = MAIN_THREAD_EM_ASM_INT({ return !!window.gxDiagnostics?.enabled; });
+        c.checked = true;
+        SDL_GXSetInputDiagnosticsEnabled(c.enabled);
+    }
+    if (!c.enabled) return;
+    ++c.updates;
+    Uint64 now = SDL_GetTicks();
+    if (now - c.sampledAt < 5000) return;
+    c.sampledAt = now;
+    // Runtime kill switch is checked only at sample frequency, never per input.
+    if (!MAIN_THREAD_EM_ASM_INT({ return !!window.gxDiagnostics?.enabled; })) {
+        c.enabled = false;
+        SDL_GXSetInputDiagnosticsEnabled(false);
+        return;
+    }
+    char workerError[256], mainError[256] = {};
+    SDL_strlcpy(workerError, SDL_GetError(), sizeof(workerError));
+    static em_proxying_queue* queue = em_proxying_queue_create();
+    bool mainErrorSampled = queue && emscripten_proxy_sync(queue,
+        emscripten_main_runtime_thread_id(), gxWebMainSdlError, mainError);
+    Uint32 internal[13] = {};
+    SDL_GXGetInputDiagnostics(internal);
+    // This public count excludes SDL's sentinel and does not dequeue events.
+    int queued = SDL_PeepEvents(nullptr, 0, SDL_PEEKEVENT, SDL_EVENT_FIRST, SDL_EVENT_LAST);
+    SDL_EventFilter filter = nullptr;
+    void* filterData = nullptr;
+    bool hasFilter = SDL_GetEventFilter(&filter, &filterData);
+    const SDL_EventType inputTypes[] = {SDL_EVENT_MOUSE_MOTION, SDL_EVENT_MOUSE_BUTTON_DOWN,
+        SDL_EVENT_MOUSE_BUTTON_UP, SDL_EVENT_MOUSE_WHEEL, SDL_EVENT_KEY_DOWN, SDL_EVENT_KEY_UP};
+    unsigned enabledTypes = 0;
+    for (unsigned i = 0; i < 6; ++i) if (SDL_EventEnabled(inputTypes[i])) enabledTypes |= 1u << i;
+    // dlmalloc's mallinfo walks free lists; sample allocator usage only every 30s.
+    static unsigned used = 0, free = 0, arena = 0;
+    if (c.sequence % 6 == 0) {
+        struct mallinfo memory = mallinfo();
+        used = memory.uordblks; free = memory.fordblks; arena = memory.arena;
+    }
+    const MouseIO* mouse = TheMouse ? TheMouse->getMouseStatus() : nullptr;
+    const unsigned values[] = {
+       (unsigned)now, c.updates, c.polled, c.mouseIn, c.mouseOut, c.mouseDropped,
+       c.buttonIn, c.buttonOut, c.buttonDropped, c.keyIn, c.keyOut, c.keyDropped,
+       (unsigned)active, TheGameLogic ? TheGameLogic->getFrame() : 0,
+       TheGameClient ? TheGameClient->getFrame() : 0,
+       (unsigned)(TheInGameUI ? TheInGameUI->getInputEnabled() : true),
+       (unsigned)(TheGameLogic ? TheGameLogic->isGamePaused() : false),
+       (unsigned)(TheWindowManager ? gxWebWindowId(TheWindowManager->winGetCapture()) : 0),
+       (unsigned)(TheWindowManager ? gxWebWindowId(TheWindowManager->winGetGrabWindow()) : 0),
+       (unsigned)(TheWindowManager ? gxWebWindowId(TheWindowManager->winGetFocus()) : 0),
+       (unsigned)(mouse ? mouse->leftState : 0), (unsigned)(mouse ? mouse->rightState : 0),
+       (unsigned)SDL_GetMouseState(nullptr, nullptr), (unsigned)(SDL_GetKeyboardFocus() != nullptr),
+       c.pollCalls, c.missingWindow, (unsigned)queued, (unsigned)hasFilter, enabledTypes,
+       // Pages avoid wasm32's 4GiB size_t wrap; JS reconstructs exact bytes.
+       (unsigned)EM_ASM_DOUBLE({ return HEAPU8.buffer.byteLength / 65536; }), used, free, arena,
+       internal[0], internal[1], internal[2], internal[3], internal[4], internal[5],
+       internal[6], internal[7], internal[8], internal[9], c.sequence++, (unsigned)mainErrorSampled, internal[10], internal[11], internal[12]
+    };
+    MAIN_THREAD_EM_ASM({
+        if (!window.gxDiagnostics?.enabled) return;
+        try {
+            const v = Array.from(HEAPU32.subarray($0 >>> 2, ($0 >>> 2) + 48));
+            // Main-thread WebAudio/OpenAL state is scanned only once per 30s.
+            // Copy counts/bytes, never AudioBuffer objects or AL resource identities.
+            if (v[43] % 6 === 0) {
+                const audio = ({available: typeof AL !== 'undefined', buffers: 0,
+                    sources: 0, audioBytes: 0, unreferenced: 0, error: null, ticksMs: v[0]});
+                try {
+                    if (audio.available) {
+                        for (const id in AL.buffers) {
+                            const buffer = AL.buffers[id];
+                            if (!buffer || !buffer.id) continue;
+                            audio.buffers++;
+                            if (buffer.refCount === 0) audio.unreferenced++;
+                            if (buffer.audioBuf) audio.audioBytes += buffer.audioBuf.length * buffer.audioBuf.numberOfChannels * 4;
+                        }
+                        for (const id in AL.contexts) {
+                            const context = AL.contexts[id];
+                            if (context) for (const source in context.sources) if (context.sources[source]) audio.sources++;
+                        }
+                        // Reading the runtime state preserves alGetError's pending error.
+                        audio.error = AL.currentCtx ? AL.currentCtx.err : null;
+                    }
+                } catch (ignored) { audio.available = false; }
+                window.gxDiagnostics.audioSnapshot = audio;
+            }
+            window.gxDiagnostics.engine({
+                ticksMs: v[0], updates: v[1], polled: v[2], mouseIn: v[3], mouseOut: v[4],
+                mouseDropped: v[5], buttonIn: v[6], buttonOut: v[7], buttonDropped: v[8],
+                keyIn: v[9], keyOut: v[10], keyDropped: v[11], active: !!v[12],
+                logicFrame: v[13], clientFrame: v[14], inputEnabled: !!v[15], paused: !!v[16],
+                captureWindow: v[17], grabWindow: v[18], focusWindow: v[19],
+                leftState: v[20], rightState: v[21], sdlButtons: v[22],
+                sdlKeyboardFocus: !!v[23], pollCalls: v[24], missingWindow: v[25],
+                sdlQueued: v[26] | 0, sdlHasFilter: !!v[27], sdlEnabledTypes: v[28],
+                wasmHeapBytes: v[29] * 65536, allocatorUsedBytes: v[30],
+                allocatorFreeBytes: v[31], allocatorArenaBytes: v[32], allocatorAgeMs: (v[43] % 6) * 5000,
+                sdlInternal: {pushAttempts: v[33], filterRejected: v[34], enqueued: v[35],
+                    enqueueFailed: v[36], queueFull: v[37], allocationFailed: v[38],
+                    inactivePeep: v[39], pollCalls: v[40], sentinels: v[41], active: !!v[42], queueCount: v[45],
+                    hasHead: !!v[46], hasTail: !!v[47]},
+                sampleSequence: v[43], mainErrorSampled: !!v[44],
+                audio: window.gxDiagnostics.audioSnapshot || null,
+                map: UTF8ToString($1)
+            });
+            // The recorder sanitizes error strings and applies a bounded budget.
+            const workerError = UTF8ToString($2);
+            const mainError = UTF8ToString($3);
+            if (workerError) window.gxDiagnostics.log('sdl.error.worker', workerError);
+            if (mainError) window.gxDiagnostics.log('sdl.error.main', mainError);
+        } catch (error) { console.error('[diagnostics] engine sample failed', error); }
+    }, values, TheGlobalData ? TheGlobalData->m_mapName.str() : "", workerError, mainError);
+}
+#endif
